{
  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:27017"
  },
  "MongoDB": {
    "DatabaseName": "agentflow_dev"
  },
  "Jwt": {
    "SecretKey": "CHANGE_IN_PRODUCTION_MIN_32_CHARS_SECRET_KEY",
    "Issuer": "agentflow",
    "Audience": "agentflow-api"
  },
  "AgentBrain": {
    "DefaultProvider": "MicrosoftAgentFramework"
  },
  "Mcp": {
    "Servers": []
  },
  "SemanticKernel": {
    "Provider": "OpenAI",
    "OpenAI": {
      "ModelId": "",
      "ApiKey": ""
    },
    "AzureOpenAI": {
      "DeploymentName": "",
      "Endpoint": "",
      "ApiKey": ""
    }
  },
  "Qdrant": {
    "Enabled": false,
    "Transport": "Http",
    "BaseUrl": "http://localhost:6333",
    "GrpcEndpoint": "http://localhost:6334",
    "CollectionPrefix": "agentflow",
    "VectorSize": 256,
    "Distance": "Cosine",
    "EnsurePayloadIndexes": true,
    "IndexedPayloadFields": ["tenant_id", "agent_id"]
  },
  "Telemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AgentFlow": "Debug"
    }
  },
  "AllowedHosts": "*"
}
