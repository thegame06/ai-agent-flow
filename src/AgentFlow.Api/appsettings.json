{
  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:27017",
    "Redis": "localhost:6379"
  },
  "MongoDB": {
    "DatabaseName": "agentflow_dev"
  },
  "Jwt": {
    "SecretKey": "CHANGE_IN_PRODUCTION_MIN_32_CHARS_SECRET_KEY",
    "Issuer": "agentflow",
    "Audience": "agentflow-api"
  },
  "AgentBrain": {
    "DefaultProvider": "MicrosoftAgentFramework"
  },
  "Mcp": {
    "Servers": []
  },
  "SemanticKernel": {
    "Provider": "OpenAI",
    "OpenAI": {
      "ModelId": "",
      "ApiKey": ""
    },
    "AzureOpenAI": {
      "DeploymentName": "",
      "Endpoint": "",
      "ApiKey": ""
    }
  },
  "Qdrant": {
    "Enabled": false,
    "Transport": "Http",
    "BaseUrl": "http://localhost:6333",
    "GrpcEndpoint": "http://localhost:6334",
    "CollectionPrefix": "agentflow",
    "VectorSize": 256,
    "Distance": "Cosine",
    "EnsurePayloadIndexes": true,
    "IndexedPayloadFields": ["tenant_id", "agent_id"]
  },
  "Telemetry": {
    "Exporter": "none",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Governance": {
    "MaxExecutionCostUsd": "0.50"
  },
  "EventTransport": {
    "Provider": "InProcess",
    "NatsUrl": "nats://localhost:4222",
    "NatsSubjectPrefix": "agentflow.events",
    "NatsDeadLetterSuffix": "deadletter",
    "DeliveryMaxAttempts": 3,
    "DeliveryBaseBackoffMs": 200,
    "DeadLetterStoreProvider": "InMemory",
    "DeadLetterRetentionHours": 72,
    "ConnectionString": "",
    "TopicName": "agentflow-events",
    "SubscriptionPrefix": "agentflow"
  },
  "ModelRoleOrchestration": {
    "Roles": {
      "Reasoning": {
        "MaxCostPer1KTokensUsd": 0.02,
        "MinContextTokens": 8000,
        "PreferredProviders": [ "openai", "azureopenai" ],
        "EnforceCostCeiling": true
      },
      "Embeddings": {
        "MaxCostPer1KTokensUsd": 0.01,
        "MinContextTokens": 1024,
        "PreferredProviders": [ "openai" ],
        "EnforceCostCeiling": true
      },
      "Moderation": {
        "MaxCostPer1KTokensUsd": 0.005,
        "PreferredProviders": [ "openai" ],
        "EnforceCostCeiling": true
      },
      "SpeechToText": {
        "MaxCostPer1KTokensUsd": 0.03,
        "PreferredProviders": [ "openai" ],
        "EnforceCostCeiling": false
      },
      "TextToSpeech": {
        "MaxCostPer1KTokensUsd": 0.03,
        "PreferredProviders": [ "openai" ],
        "EnforceCostCeiling": false
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AgentFlow": "Debug"
    }
  },
  "AllowedHosts": "*"
}
